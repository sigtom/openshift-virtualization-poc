#!/bin/bash
# Competitor flows (background). usage:
#   poc-net-load start tcp|tcp-rev|udp SERVER_POD_IP FIRST_PORT COUNT MBPS_PER_FLOW [seconds=1800]
#   poc-net-load stop | status
# Each flow is capped at MBPS_PER_FLOW and ends by itself after the time limit.
# Only flows started here are stopped (pid + start time + command checked).
PIDS="${POC_STATE_DIR:-/var/tmp}/poc-net-load.pids"
isnum() { case $1 in ''|*[!0-9]*) return 1 ;; esac; }
inrange() { isnum "$1" && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; }
# Helper-owned process tracking: a process is ours only if its pid, its start time and its
# command line all still match what was recorded. Nothing is ever stopped by name alone.
pstart() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | awk '{print $20}'; }
owned() { [ -n "$3" ] && [ -n "$2" ] && [ "$(pstart "$1")" = "$2" ] && tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null | grep -q -- "$3"; }
record() { echo "$1 $(pstart "$1") $2" >>"$PIDS"; }
prune() {
  [ -f "$PIDS" ] || return 0
  tmp="$PIDS.tmp.$$"; : >"$tmp"
  while read -r p s b; do owned "$p" "$s" "$b" && echo "$p $s $b" >>"$tmp"; done <"$PIDS"
  if [ -s "$tmp" ]; then mv "$tmp" "$PIDS"; else rm -f "$tmp" "$PIDS"; fi
}
live_count() { prune; if [ -s "$PIDS" ]; then wc -l <"$PIDS" | tr -d ' '; else echo 0; fi; }
stop_owned() {
  prune
  if [ ! -s "$PIDS" ]; then echo "Nothing started by this helper is running."; return 0; fi
  while read -r p s b; do owned "$p" "$s" "$b" && { pkill -TERM -P "$p" 2>/dev/null; kill -TERM "$p" 2>/dev/null; }; done <"$PIDS"
  sleep 2
  while read -r p s b; do owned "$p" "$s" "$b" && { pkill -KILL -P "$p" 2>/dev/null; kill -KILL "$p" 2>/dev/null; }; done <"$PIDS"
  rm -f "$PIDS"
  echo "Stopped helper-started processes at $(date -u +%FT%TZ). Other processes were not touched."
}
case ${1:-} in
  start)
    mode=${2:-}; srv=${3:-}; first=${4:-}; count=${5:-}; mbps=${6:-}; secs=${7:-1800}
    use() { echo "usage: poc-net-load start tcp|tcp-rev|udp SERVER_POD_IP FIRST_PORT(1024-65535) COUNT(1-8) MBPS_PER_FLOW(1-10000) [seconds 1-7200]"; exit 2; }
    case $mode in tcp|tcp-rev|udp) ;; *) use ;; esac
    case $srv in ''|-*|*[!A-Za-z0-9.:_-]*) echo "Server address missing or not valid."; use ;; esac
    inrange "$first" 1024 65535 && inrange "$count" 1 8 && inrange "$mbps" 1 10000 && inrange "$secs" 1 7200 || use
    [ $((first + count - 1)) -le 65535 ] || use
    if ! command -v iperf3 >/dev/null; then echo "BLOCKED: iperf3 is not installed in this VM. Tell the administrator."; exit 2; fi
    IFACE=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
    BIND=${POC_BIND:-$(ip -4 -o addr show dev "$IFACE" 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}')}
    case $BIND in ''|*[!0-9.]*) echo "Could not find this VM's IPv4 address. Set it: export POC_BIND=<guest address from poc-net-info>"; exit 2 ;; esac
    if [ "$(live_count)" -gt 0 ]; then echo "Flows from this helper are already running. Run: poc-net-load stop"; exit 1; fi
    i=0
    while [ "$i" -lt "$count" ]; do
      p=$((first + i))
      a=(-c "$srv" -p "$p" -B "$BIND" -t "$secs" -b "${mbps}M" -i 0 --logfile "${POC_STATE_DIR:-/var/tmp}/poc-net-load-$p.log")
      [ "$mode" = tcp-rev ] && a+=(-R)
      [ "$mode" = udp ] && a+=(-u -l 1200)
      nohup iperf3 "${a[@]}" >/dev/null 2>&1 &
      record "$!" "iperf3"
      i=$((i + 1))
    done
    sleep "${POC_START_WAIT:-3}"
    n=$(live_count)
    if [ "$n" -lt "$count" ]; then
      echo "FAILED: only $n of $count flows are running. Is the server listener up on those ports? Last log lines:"
      tail -n 2 "${POC_STATE_DIR:-/var/tmp}"/poc-net-load-*.log 2>/dev/null
      stop_owned >/dev/null; exit 1
    fi
    echo "Started $n $mode flow(s) of ${mbps} Mbit/s to $srv from port $first at $(date -u +%FT%TZ), for ${secs}s." ;;
  stop) stop_owned ;;
  status) echo "$(live_count) competitor flow(s) from this helper are running." ;;
  *) echo "usage: poc-net-load start|stop|status"; exit 2 ;;
esac
